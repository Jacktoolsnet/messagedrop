NODE_ENV=development
OVERPASS_PORT=3900

OVERPASS_API_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_TIMEOUT_MS=20000
OVERPASS_QUERY_TIMEOUT_SECONDS=15
OVERPASS_MAX_RESPONSE_BYTES=10485760
OVERPASS_USER_AGENT=MessageDrop-Overpass-Service/1.0

# PostgreSQL-backed cache. The database itself must exist; the service creates
# its cache table and index automatically.
OVERPASS_DATABASE_URL=
OVERPASS_DB_HOST=localhost
OVERPASS_DB_PORT=5432
OVERPASS_DB_NAME=messagedrop_overpass
OVERPASS_DB_USER=messagedrop
OVERPASS_DB_PASSWORD=messagedrop_dev_password
OVERPASS_DB_SSL=false
OVERPASS_DB_POOL_MAX=10
OVERPASS_DB_MAX_PENDING_REQUESTS=1000

# In-memory hot cache plus persistent cache lifecycle.
OVERPASS_CACHE_TTL_MS=21600000
OVERPASS_CACHE_MAX_ENTRIES=256
OVERPASS_CACHE_MAX_BYTES=67108864
OVERPASS_CACHE_REFRESH_AFTER_MS=86400000
OVERPASS_DATABASE_CACHE_TTL_MS=604800000
OVERPASS_CACHE_STALE_IF_ERROR_MS=2592000000
OVERPASS_DATABASE_RETENTION_DAYS=90
OVERPASS_DATASET_RETIRED_VERSIONS=0
# Temporary Geofabrik downloads. Relative paths are resolved below services/overpass.
OVERPASS_DOWNLOAD_DIR=./downloads
OVERPASS_API_BASE_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_IP_FAMILY=4
OVERPASS_MAX_IN_FLIGHT=2
OVERPASS_MAX_BBOX_AREA=0.05
OVERPASS_MAX_RESULTS=500

# Fetch only the HTML <head> for metadata enrichment. Website targets must use
# public HTTPS addresses; private/local networks and non-standard ports are rejected.
OVERPASS_WEBSITE_METADATA_TIMEOUT_MS=8000
OVERPASS_WEBSITE_METADATA_MAX_BYTES=262144
OVERPASS_WEBSITE_METADATA_MAX_REDIRECTS=3

# Defaults for scripts/fetch-raw-poi-sample.js (Hanover region).
OVERPASS_SAMPLE_SOUTH=52.34
OVERPASS_SAMPLE_WEST=9.65
OVERPASS_SAMPLE_NORTH=52.43
OVERPASS_SAMPLE_EAST=9.85
OVERPASS_SAMPLE_CATEGORIES=accommodation,tourism
OVERPASS_SAMPLE_LIMIT=500

SERVICE_JWT_AUDIENCE=service.overpass
OVERPASS_SERVICE_JWT_ISSUER=service.overpass
SERVICE_JWT_AUDIENCE_ADMIN=service.admin-backend
SERVICE_JWT_TRUSTED_JWKS_PATH=./config/service-jwks.json

ENCRYPTION_KEY_PASSWORD=change_me
SIGNING_KEY_PASSWORD=change_me

ADMIN_BASE_URL=http://localhost
ADMIN_PORT=3100
ADMIN_LOG_URL=
LOG_RETENTION_INFO=2d
