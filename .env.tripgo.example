NODE_ENV=development
TRIPGO_PORT=3800

# TripGo upstream API. Keep the real key only in the ignored root .env file.
TRIPGO_API_BASE_URL=https://api.tripgo.com/v1
TRIPGO_API_KEY=change_me
TRIPGO_API_TIMEOUT_MS=15000

# PostgreSQL cache for mostly static stop/location metadata. The database user
# must be allowed to create the cache table and its index.
TRIPGO_DATABASE_URL=
TRIPGO_DB_HOST=localhost
TRIPGO_DB_PORT=5432
TRIPGO_DB_NAME=messagedrop_tripgo
TRIPGO_DB_USER=messagedrop
TRIPGO_DB_PASSWORD=change_me
TRIPGO_DB_SSL=false
TRIPGO_DB_POOL_MAX=10
TRIPGO_DB_MAX_PENDING_REQUESTS=1000

# Bounded in-memory caches. Set the route TTL to 0 to disable route caching;
# identical requests that are currently in flight are still coalesced.
TRIPGO_REGIONS_CACHE_TTL_MS=21600000
TRIPGO_REGIONS_CACHE_MAX_ENTRIES=8
TRIPGO_REGIONS_CACHE_MAX_BYTES=16777216
TRIPGO_ROUTE_CACHE_TTL_MS=15000
TRIPGO_ROUTE_CACHE_MAX_ENTRIES=64
TRIPGO_ROUTE_CACHE_MAX_BYTES=33554432
TRIPGO_LOCATIONS_MEMORY_CACHE_TTL_MS=3600000
TRIPGO_LOCATIONS_CACHE_MAX_ENTRIES=256
TRIPGO_LOCATIONS_CACHE_MAX_BYTES=33554432

# Persistent locations cache: revalidate after one day, normally retain for
# seven days and use an older record for up to 30 days if TripGo is unavailable.
TRIPGO_LOCATIONS_REFRESH_AFTER_MS=86400000
TRIPGO_LOCATIONS_CACHE_TTL_MS=604800000
TRIPGO_LOCATIONS_STALE_IF_ERROR_MS=2592000000
TRIPGO_LOCATIONS_DATABASE_RETENTION_DAYS=30
TRIPGO_MAX_IN_FLIGHT=100
TRIPGO_MAX_ROUTE_OPTIONS=12
TRIPGO_ROUTE_OPTIONS_PER_GROUP=2

SERVICE_JWT_AUDIENCE=service.tripgo
TRIPGO_SERVICE_JWT_ISSUER=service.tripgo
SERVICE_JWT_AUDIENCE_ADMIN=service.admin-backend
SERVICE_JWT_TRUSTED_JWKS_PATH=./config/service-jwks.json

ENCRYPTION_KEY_PASSWORD=change_me
SIGNING_KEY_PASSWORD=change_me

ADMIN_BASE_URL=http://localhost
ADMIN_PORT=3100
ADMIN_LOG_URL=
LOG_RETENTION_INFO=2d
