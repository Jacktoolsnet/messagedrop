{
  "name": "messagedrop-geodata-service",
  "version": "1.0.0",
  "private": true,
  "description": "Versioned local OpenStreetMap geodata service for MessageDrop.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "node --test",
    "lint": "eslint .",
    "db:create": "node scripts/create-database.js",
