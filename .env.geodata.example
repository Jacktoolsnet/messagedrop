NODE_ENV=development
GEODATA_PORT=3900

GEODATA_USER_AGENT=MessageDrop-Geodata-Service/1.0

# PostgreSQL database. The database itself must exist; the service creates its
# tables and indexes automatically.
GEODATA_DATABASE_URL=
GEODATA_DB_HOST=localhost
GEODATA_DB_PORT=5432
GEODATA_DB_NAME=messagedrop_geodata
GEODATA_DB_USER=messagedrop
GEODATA_DB_PASSWORD=messagedrop_dev_password
GEODATA_DB_SSL=false
GEODATA_DB_POOL_MAX=10
GEODATA_DB_MAX_PENDING_REQUESTS=1000
# Cache the comparatively expensive aggregate database statistics used by /health.
GEODATA_STATUS_CACHE_MS=60000

# Completed import and website-metadata job history.
GEODATA_JOB_RETENTION_DAYS=90
GEODATA_DATASET_RETIRED_VERSIONS=0
# Temporary Geofabrik downloads. Relative paths are resolved below services/geodata.
GEODATA_DOWNLOAD_DIR=./downloads
GEODATA_MAX_BBOX_AREA=0.05
GEODATA_MAX_RESULTS=500

# Fetch only the HTML <head> for metadata enrichment. Website targets must use
# public HTTPS addresses; private/local networks and non-standard ports are rejected.
GEODATA_WEBSITE_METADATA_TIMEOUT_MS=8000
GEODATA_WEBSITE_METADATA_MAX_BYTES=262144
GEODATA_WEBSITE_METADATA_MAX_REDIRECTS=3
GEODATA_WEBSITE_METADATA_REFRESH_DAYS=30
# First retry; later transient failures back off to 6h, 24h, 3d and then 7d.
GEODATA_WEBSITE_METADATA_RETRY_HOURS=1
# Different domains are processed concurrently. Requests to the same domain
# remain serialized and keep this minimum pause between requests.
GEODATA_WEBSITE_METADATA_CONCURRENCY=4
GEODATA_WEBSITE_METADATA_DOMAIN_DELAY_MS=1000
GEODATA_WEBSITE_METADATA_JOB_MAX_URLS=100000

SERVICE_JWT_AUDIENCE=service.geodata
GEODATA_SERVICE_JWT_ISSUER=service.geodata
SERVICE_JWT_AUDIENCE_ADMIN=service.admin-backend
SERVICE_JWT_TRUSTED_JWKS_PATH=./config/service-jwks.json

ENCRYPTION_KEY_PASSWORD=change_me
SIGNING_KEY_PASSWORD=change_me

ADMIN_BASE_URL=http://localhost
ADMIN_PORT=3100
ADMIN_LOG_URL=
LOG_RETENTION_INFO=2d
